# 图元后端环境变量示例（docker compose 已在根目录 .env 中统一管理，
# 此文件供脱离 compose 单独运行时参考）

FLASK_ENV=production

# 数据库（compose 中由根目录 .env 拼接生成）
DATABASE_URL=postgresql+psycopg2://image_atom:CHANGE_ME@postgres:5432/image_atom

# 密钥（生产环境必须修改，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# 初始账号：仅数据库为空时首次启动生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 上传目录与大小限制
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH_MB=50

# 站点启用 HTTPS 后改为 true（refresh cookie 将携带 Secure 标记）
COOKIE_SECURE=false

# 如需允许跨域访问接口，填写来源，逗号分隔；留空表示关闭 CORS
CORS_ORIGINS=
